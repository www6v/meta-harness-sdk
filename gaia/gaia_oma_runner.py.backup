#!/usr/bin/env python3
"""GAIA Level-1 benchmark runner for oma-platform.

Reads the GAIA validation metadata parquet, picks every Level-1 question,
drives an oma-platform agent through it, extracts the agent's final answer
and compares it to the ground truth.

Outputs
-------
* ``results/<run_id>.jsonl``  — per-question trace
* ``results/<run_id>.md``     — summary + defect catalog

Usage
-----
    OMA_BASE_URL=http://127.0.0.1:8787 \\
    OMA_API_KEY=oma_... \\
    python gaia/gaia_oma_runner.py --limit 5
"""

from __future__ import annotations

import argparse
import asyncio
import hashlib
import json
import os
import re
import time
import urllib.parse
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

import httpx
import pandas as pd

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
GAIA_DATA_DIR = Path(__file__).parent / "data"
VALIDATION_PARQUET = GAIA_DATA_DIR / "2023" / "validation" / "metadata.parquet"
RESULTS_DIR = Path(__file__).parent / "results"

OMA_BASE_URL = os.getenv("OMA_BASE_URL", "http://127.0.0.1:8787").rstrip("/")
OMA_API_KEY = os.getenv("OMA_API_KEY", "")

ENVIRONMENT_ID = os.getenv("OMA_ENVIRONMENT_ID", "env-o1krx78fqanlwz6g")
AGENT_ID = os.getenv("OMA_AGENT_ID", "agent-kdofz46oe6pa51j1")
AGENT_VERSION = int(os.getenv("OMA_AGENT_VERSION", "1"))

DEFAULT_MODEL = os.getenv("OMA_MODEL", "qwen3.7-plus")

PER_Q_TIMEOUT = float(os.getenv("GAIA_PER_Q_TIMEOUT", "300"))  # seconds
MAX_TOOL_CALLS = int(os.getenv("GAIA_MAX_TOOL_CALLS", "30"))   # loop guard
MAX_CONCURRENCY = int(os.getenv("GAIA_CONCURRENCY", "1"))


GAIA_SYSTEM_PROMPT = """\
You are a precise QA assistant answering benchmark questions.

Rules:
- Read attached files first if the question references one.
- Use web_search / web_fetch only when the answer requires up-to-date info.
- Be concise. End your reply with a line exactly in this format:
    ANSWER: <your_final_answer>
  The <your_final_answer> is the shortest possible string that answers
  the question (number, name, date, short phrase). No extra punctuation.
- If you cannot determine the answer, say: ANSWER: UNKNOWN

Tool-loop policy:
- If the same tool call fails three times in a row with substantively
  the same error, STOP retrying. Instead emit a final ANSWER line that
  reports (a) what you were trying to do, (b) the exact error, and
  (c) what you would need to make progress. Then end the turn.

Answer completeness:
- Names: use the full name (first + last) the question asks for.
- Numbers: double-check which column/field the question is about before
  writing the digit string.
- Before emitting ANSWER, re-read the question and confirm your answer
  covers every part of it.
"""


# ---------------------------------------------------------------------------
# Event parsing helpers
# ---------------------------------------------------------------------------
def _stop_reason_type(evt: dict[str, Any]) -> str | None:
    """Extract ``stop_reason.type`` from a session.status_idle payload.

    The Go server emits ``stop_reason`` as a nested dict, e.g.
    ``{"type": "end_turn"}`` or ``{"type": "requires_action", ...}``.
    Returns None when stop_reason is missing or not a dict.

    Parity with ``oma-platform/sdk/oma_sdk/cookbook.py::stop_reason_type``.
    """
    stop_reason = evt.get("stop_reason")
    if isinstance(stop_reason, dict):
        reason_type = stop_reason.get("type")
        if reason_type:
            return str(reason_type)
    return None


def _tool_call_fingerprint(call: dict) -> str:
    """Stable identity for 'same tool called with same input'."""
    name = str(call.get("name") or "")
    inp = call.get("input") or {}
    try:
        inp_key = json.dumps(inp, sort_keys=True, ensure_ascii=False)
    except Exception:
        inp_key = repr(inp)
    return f"{name}|{hashlib.md5(inp_key.encode('utf-8')).hexdigest()[:12]}"


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------
def headers() -> dict[str, str]:
    return {
        "x-api-key": OMA_API_KEY,
        "content-type": "application/json",
    }


def http_get(path: str, **kw) -> Any:
    r = httpx.get(f"{OMA_BASE_URL}{path}", headers=headers(), timeout=30, **kw)
    r.raise_for_status()
    return r.json()


def http_post(path: str, body: Any) -> Any:
    r = httpx.post(
        f"{OMA_BASE_URL}{path}", headers=headers(),
        timeout=30, content=json.dumps(body),
    )
    r.raise_for_status()
    return r.json()


# ---------------------------------------------------------------------------
# GAIA loading
# ---------------------------------------------------------------------------
def load_l1() -> pd.DataFrame:
    df = pd.read_parquet(VALIDATION_PARQUET)
    l1 = df[df["Level"].astype(str) == "1"].copy()
    l1 = l1.reset_index(drop=True)
    print(f"Loaded {len(l1)} Level-1 questions from {VALIDATION_PARQUET}")
    return l1


# ---------------------------------------------------------------------------
# Agent interaction
# ---------------------------------------------------------------------------
@dataclass
class QResult:
    task_id: str
    question: str
    file_name: str | None
    ground_truth: str
    prediction: str = ""
    passed: bool = False
    status: str = "pending"          # ok / timeout / error / loop / no_answer
    tool_calls: list[dict] = field(default_factory=list)
    error: str | None = None
    elapsed_s: float = 0.0
    n_events: int = 0
    n_tool_calls: int = 0
    session_id: str | None = None
    defect_tags: list[str] = field(default_factory=list)


def ensure_agent() -> None:
    """Quick liveness + config check."""
    me = http_get("/v1/me")
    print(f"✓ oma-platform: tenant={me['tenant']['name']}")
    agent = http_get(f"/v1/agents/{AGENT_ID}")
    print(f"✓ agent: {agent['name']}  model={agent['model']['id']}  v{agent['version']}")
    tools = {t.get("name") for t in agent.get("tools", []) if t.get("name")}
    toolset_types = [t.get("type") for t in agent.get("tools", [])]
    print(f"  tools: {sorted(tools) or '(only toolset: ' + str(toolset_types) + ')'}")


def create_session(question: str, file_path: Path | None = None) -> str:
    body: dict[str, Any] = {
        "environment_id": ENVIRONMENT_ID,
        "agent": {"type": "agent", "id": AGENT_ID, "version": AGENT_VERSION},
        "title": f"gaia-l1-{int(time.time())}",
    }
    if file_path and file_path.exists():
        # Upload file, mount on session
        with file_path.open("rb") as f:
            data = f.read()
        # Multipart upload
        r = httpx.post(
            f"{OMA_BASE_URL}/v1/files",
            headers={"x-api-key": OMA_API_KEY},
            files={"file": (file_path.name, data, "application/octet-stream")},
            data={"downloadable": "true", "scope": "session"},
            timeout=60,
        )
        r.raise_for_status()
        file_rec = r.json()
        body["resources"] = [{
            "type": "file",
            "file_id": file_rec["id"],
            "mount_path": f"/mnt/session/input/{file_path.name}",
        }]
    rec = http_post("/v1/sessions", body)
    return rec["id"]


def send_question(session_id: str, question: str, file_path: Path | None) -> None:
    if file_path and file_path.exists():
        text = (
            f"Attached file: /mnt/session/input/{file_path.name}\n\n"
            f"Question: {question}"
        )
    else:
        text = question
    http_post(f"/v1/sessions/{session_id}/events", {
        "events": [{"type": "user.message", "content": [{"type": "text", "text": text}]}]
    })


def stream_events(session_id: str, qr: QResult) -> None:
    """Pull events via SSE with HTTP polling fallback.

    Tries SSE first. If no events received within 10 seconds, falls back
    to HTTP polling for reliability (works around network/proxy issues
    that can buffer or drop SSE streams from external connections).
    """
    t0 = time.time()
    assistant_texts: list[str] = []
    qr.tool_calls = []
    # Consecutive-failure loop detector.
    last_tool_key: str | None = None
    consecutive_failures = 0
    LOOP_DETECTION_WINDOW = int(os.getenv("GAIA_LOOP_WINDOW", "3"))

    # Try SSE first with early detection of connectivity issues.
    sse_received_events = False
    resp_ctx = None
    resp = None
    try:
        resp_ctx = httpx.stream(
            "GET",
            f"{OMA_BASE_URL}/v1/sessions/{session_id}/events/stream",
            params={"replay": "1"},
            headers={"x-api-key": OMA_API_KEY, "accept": "text/event-stream"},
            timeout=httpx.Timeout(connect=10, read=PER_Q_TIMEOUT, write=10, pool=10),
        )
        resp = resp_ctx.__enter__()
        buf = b""
        sse_start = time.time()
        for chunk in resp.iter_bytes():
            if time.time() - t0 > PER_Q_TIMEOUT:
                qr.status = "timeout"
                qr.defect_tags.append("timeout")
                break
            buf += chunk
            while b"\n\n" in buf:
                msg, buf = buf.split(b"\n\n", 1)
                lines = msg.decode("utf-8", errors="replace").splitlines()
                data_line = next((l for l in lines if l.startswith("data: ")), None)
                if not data_line:
                    continue
                try:
                    evt = json.loads(data_line[6:])
                except json.JSONDecodeError:
                    continue
                sse_received_events = True
                qr.n_events += 1
                # Debug logging.
                with open("/tmp/gaia_events.log", "a") as f:
                    f.write(f"Event {qr.n_events}: {evt.get('type')}\n")
                # Log full session.status_idle events for inspection.
                if evt.get("type") == "session.status_idle":
                    with open("/tmp/gaia_idle_events.jsonl", "a") as f:
                        f.write(json.dumps(evt, ensure_ascii=False) + "\n")
                if qr.n_events % 10 == 0:
                    print(f"  DEBUG: Processed {qr.n_events} events so far...", flush=True)
                _process_event(evt, qr, assistant_texts)

                # Loop detection.
                if evt.get("type") == "agent.tool_result" and qr.tool_calls:
                    last_call = qr.tool_calls[-1]
                    if last_call.get("output_is_error"):
                        key = _tool_call_fingerprint(last_call)
                        if key == last_tool_key:
                            consecutive_failures += 1
                        else:
                            last_tool_key = key
                            consecutive_failures = 1
                        if consecutive_failures >= LOOP_DETECTION_WINDOW:
                            qr.status = "loop"
                            qr.defect_tags.append("tool_loop")
                            try:
                                http_post(f"/v1/sessions/{session_id}/events", {
                                    "events": [{"type": "user.interrupt"}]
                                })
                            except Exception:
                                pass
                            break
                    else:
                        last_tool_key = None
                        consecutive_failures = 0

                # Fallback: Detect ANSWER and proactively terminate.
                if assistant_texts and qr.status not in ("ok", "timeout", "loop", "error"):
                    full_text = "\n".join(assistant_texts)
                    if re.search(r"(?im)^\s*ANSWER:\s*.+$", full_text):
                        time.sleep(2)
                        if qr.status not in ("ok", "timeout", "loop", "error"):
                            qr.status = qr.status or "ok"
                            try:
                                http_post(f"/v1/sessions/{session_id}/events", {
                                    "events": [{"type": "user.interrupt"}]
                                })
                            except Exception:
                                pass
                            print(f"  DEBUG: ANSWER fallback - breaking with status={qr.status}", flush=True)
                            break

                # Termination conditions.
                ev_type = evt.get("type")
                if ev_type == "session.status_idle":
                    reason = _stop_reason_type(evt)
                    print(f"  DEBUG: session.status_idle - reason={reason}, stop_reason_raw={evt.get('stop_reason')}, n_tool_calls={qr.n_tool_calls}", flush=True)
                    if reason == "end_turn":
                        qr.status = qr.status or "ok"
                        print(f"  DEBUG: Breaking due to end_turn", flush=True)
                        break
                    if reason in ("requires_action", None) and qr.n_tool_calls > 0:
                        qr.status = qr.status or "ok"
                        print(f"  DEBUG: Breaking due to requires_action/None", flush=True)
                        break
                if ev_type == "turn.end":
                    qr.status = qr.status or "ok"
                    break
                if qr.n_tool_calls > MAX_TOOL_CALLS:
                    qr.status = "loop"
                    qr.defect_tags.append("tool_loop")
                    try:
                        http_post(f"/v1/sessions/{session_id}/events", {
                            "events": [{"type": "user.interrupt"}]
                        })
                    except Exception:
                        pass
                    break
            if qr.status in ("ok", "timeout", "loop", "error"):
                print(f"  DEBUG: Exiting for loop due to status={qr.status}", flush=True)
                break
            # If no events after 10 seconds, switch to polling.
            if not sse_received_events and time.time() - sse_start > 10:
                print("  DEBUG: No SSE events in 10s, switching to HTTP polling", flush=True)
                break
    except Exception as e:
        print(f"  DEBUG: SSE failed ({e}), switching to HTTP polling", flush=True)
    finally:
        # Don't explicitly close - let Python GC handle it to avoid hanging.
        pass

    print(f"  DEBUG: After SSE loop - sse_received_events={sse_received_events}, status={qr.status}, n_events={qr.n_events}", flush=True)

    # If SSE didn't work, use HTTP polling.
    if not sse_received_events and qr.status not in ("ok", "loop", "error"):
        print(f"  DEBUG: Entering HTTP polling fallback", flush=True)
        _poll_events(session_id, qr, assistant_texts, t0)
    else:
        print(f"  DEBUG: Skipping polling fallback", flush=True)

    qr.elapsed_s = time.time() - t0
    qr.prediction = _extract_answer(assistant_texts)
    if not qr.prediction:
        qr.status = "no_answer"
        qr.defect_tags.append("no_answer_extracted")


def _poll_events(session_id: str, qr: QResult, assistant_texts: list[str], t0: float) -> None:
    """HTTP polling fallback for when SSE is unreliable."""
    last_seq = 0
    last_tool_key: str | None = None
    consecutive_failures = 0
    LOOP_DETECTION_WINDOW = int(os.getenv("GAIA_LOOP_WINDOW", "3"))

    while time.time() - t0 < PER_Q_TIMEOUT:
        try:
            # Poll events.
            events_resp = http_get(f"/v1/sessions/{session_id}/events", params={"after_seq": last_seq})
            events = events_resp.get("events", [])
            for evt in events:
                seq = evt.get("seq")
                if isinstance(seq, int):
                    last_seq = max(last_seq, seq)
                qr.n_events += 1
                _process_event(evt, qr, assistant_texts)

                # Loop detection.
                if evt.get("type") == "agent.tool_result" and qr.tool_calls:
                    last_call = qr.tool_calls[-1]
                    if last_call.get("output_is_error"):
                        key = _tool_call_fingerprint(last_call)
                        if key == last_tool_key:
                            consecutive_failures += 1
                        else:
                            last_tool_key = key
                            consecutive_failures = 1
                        if consecutive_failures >= LOOP_DETECTION_WINDOW:
                            qr.status = "loop"
                            qr.defect_tags.append("tool_loop")
                            try:
                                http_post(f"/v1/sessions/{session_id}/events", {
                                    "events": [{"type": "user.interrupt"}]
                                })
                            except Exception:
                                pass
                            return
                    else:
                        last_tool_key = None
                        consecutive_failures = 0

                # Termination conditions.
                ev_type = evt.get("type")
                if ev_type == "session.status_idle":
                    reason = _stop_reason_type(evt)
                    if reason == "end_turn":
                        qr.status = qr.status or "ok"
                        return
                    if reason in ("requires_action", None) and qr.n_tool_calls > 0:
                        qr.status = qr.status or "ok"
                        return
                if ev_type == "turn.end":
                    qr.status = qr.status or "ok"
                    return

            # Check if we have ANSWER.
            if assistant_texts:
                full_text = "\n".join(assistant_texts)
                if re.search(r"(?im)^\s*ANSWER:\s*.+$", full_text):
                    qr.status = qr.status or "ok"
                    try:
                        http_post(f"/v1/sessions/{session_id}/events", {
                            "events": [{"type": "user.interrupt"}]
                        })
                    except Exception:
                        pass
                    return

            # Poll session status.
            session = http_get(f"/v1/sessions/{session_id}")
            if session.get("status") == "idle":
                if qr.n_tool_calls > 0:
                    qr.status = qr.status or "ok"
                    return

            if qr.n_tool_calls > MAX_TOOL_CALLS:
                qr.status = "loop"
                qr.defect_tags.append("tool_loop")
                try:
                    http_post(f"/v1/sessions/{session_id}/events", {
                        "events": [{"type": "user.interrupt"}]
                    })
                except Exception:
                    pass
                return

            time.sleep(1)  # Poll every second.
        except Exception as e:
            print(f"  DEBUG: Polling error: {e}", flush=True)
            time.sleep(1)
            continue

    # Timeout.
    qr.status = "timeout"
    qr.defect_tags.append("timeout")


def _process_event(evt: dict, qr: QResult, assistant_texts: list[str]) -> None:
    t = evt.get("type", "")
    if t == "agent.tool_use":
        qr.n_tool_calls += 1
        qr.tool_calls.append({
            "seq": qr.n_tool_calls,
            "name": evt.get("name"),
            "input": evt.get("input"),
        })
    elif t == "agent.tool_result":
        # Pair with most recent tool_use
        content = evt.get("content") or []
        text = " ".join(c.get("text", "") for c in content if c.get("type") == "text")
        if qr.tool_calls:
            qr.tool_calls[-1]["output_head"] = text[:300]
            qr.tool_calls[-1]["output_is_error"] = _looks_like_error(text)
            if qr.tool_calls[-1]["output_is_error"]:
                tool = qr.tool_calls[-1]["name"]
                tag = f"tool_{tool}_error"
                if tag not in qr.defect_tags:
                    qr.defect_tags.append(tag)
    elif t in ("assistant.message", "agent.message"):  # Support both event types
        for c in evt.get("content", []):
            if c.get("type") == "text":
                assistant_texts.append(c.get("text", ""))
    elif t == "session.lifecycle" and evt.get("phase") == "turn_end":
        pass
    elif t.startswith("span.error") or t == "turn.error":
        qr.defect_tags.append("platform_error")


def _looks_like_error(text: str) -> bool:
    s = text.strip()
    if not s:
        return True
    low = s.lower()
    if low in ("error:", "error", "no output", "(no output)"):
        return True
    if "traceback" in low and ("error" in low or "exception" in low):
        return True
    if "command exited with code" in low and "code 0" not in low:
        return True
    if "connect tunnel failed" in low:
        return True
    return False


_ANS_RE = re.compile(r"(?im)^\s*ANSWER:\s*(.+?)\s*$")


def _extract_answer(texts: list[str]) -> str:
    full = "\n".join(texts)
    m = _ANS_RE.findall(full)
    if m:
        return m[-1].strip().strip("`\"'")
    # Fallback: last non-empty line
    lines = [ln.strip() for ln in full.splitlines() if ln.strip()]
    return lines[-1][:200] if lines else ""


def grade(prediction: str, truth: str) -> bool:
    if not prediction or prediction == "UNKNOWN":
        return False
    # GAIA uses exact string match after basic normalization
    norm = lambda s: str(s).strip().lower().replace(",", "").replace('"', "").replace("'", "")
    return norm(prediction) == norm(truth)


# ---------------------------------------------------------------------------
# Per-question driver
# ---------------------------------------------------------------------------
def run_one(row: pd.Series) -> QResult:
    qr = QResult(
        task_id=row["task_id"],
        question=row["Question"],
        file_name=row.get("file_name") or None,
        ground_truth=str(row["Final answer"]) if pd.notna(row["Final answer"]) else "",
    )

    file_path: Path | None = None
    if qr.file_name:
        candidate = GAIA_DATA_DIR / row["file_path"]
        if candidate.exists():
            file_path = candidate
        else:
            qr.defect_tags.append("missing_file")
            qr.error = f"file not found on disk: {candidate}"

    try:
        qr.session_id = create_session(qr.question, file_path)
        send_question(qr.session_id, qr.question, file_path)
        stream_events(qr.session_id, qr)
    except Exception as e:
        qr.status = "error"
        qr.error = str(e)
        qr.defect_tags.append("runner_exception")

    qr.passed = grade(qr.prediction, qr.ground_truth)
    return qr


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
def write_report(run_id: str, results: list[QResult]) -> Path:
    RESULTS_DIR.mkdir(exist_ok=True)
    jsonl_path = RESULTS_DIR / f"{run_id}.jsonl"
    md_path = RESULTS_DIR / f"{run_id}.md"

    with jsonl_path.open("w") as f:
        for qr in results:
            f.write(json.dumps({
                "task_id": qr.task_id,
                "question": qr.question[:300],
                "file_name": qr.file_name,
                "ground_truth": qr.ground_truth,
                "prediction": qr.prediction,
                "passed": qr.passed,
                "status": qr.status,
                "elapsed_s": round(qr.elapsed_s, 1),
                "n_events": qr.n_events,
                "n_tool_calls": qr.n_tool_calls,
                "session_id": qr.session_id,
                "defect_tags": qr.defect_tags,
                "tool_calls": qr.tool_calls[:8],  # cap
                "error": qr.error,
            }, ensure_ascii=False) + "\n")

    total = len(results)
    passed = sum(1 for r in results if r.passed)
    status_counts = {}
    defect_counts: dict[str, int] = {}
    for r in results:
        status_counts[r.status] = status_counts.get(r.status, 0) + 1
        for tag in r.defect_tags:
            defect_counts[tag] = defect_counts.get(tag, 0) + 1

    lines = [
        f"# GAIA L1 Run {run_id}",
        "",
        f"- **Accuracy**: {passed}/{total} = {passed/total:.1%}" if total else "- no questions",
        f"- **Status breakdown**: {status_counts}",
        f"- **Defect tags**: {defect_counts}",
        "",
        "## Per-question",
        "",
        "| # | task_id | status | pass | truth | prediction | defect_tags | elapsed |",
        "|---|---------|--------|------|-------|------------|-------------|---------|",
    ]
    for i, r in enumerate(results, 1):
        lines.append(
            f"| {i} | {r.task_id[:8]} | {r.status} | "
            f"{'✅' if r.passed else '❌'} | "
            f"{_cell(r.ground_truth)} | {_cell(r.prediction)} | "
            f"{','.join(r.defect_tags) or '—'} | {r.elapsed_s:.0f}s |"
        )

    lines += ["", "## Defect catalog", ""]
    lines += [
        "- **tool_web_search_error**: `web_search` returns empty `Error:` for every query — likely harness-side config missing or upstream search provider unreachable.",
        "- **tool_web_fetch_error**: `web_fetch` fails markdown extraction, returns raw HTML wrapped in `[NOTE: markdown extraction unavailable ...]`.",
        "- **tool_bash_error / outbound proxy 501**: sandbox outbound proxy (127.0.0.1:8790) returns `501 Not Implemented` on HTTPS CONNECT, so `curl` from bash cannot reach external HTTPS sites.",
        "- **tool_loop**: agent doesn't recognize tool failure and retries the same calls indefinitely, burning tokens without producing an answer.",
        "- **timeout**: the loop above typically runs until `GAIA_PER_Q_TIMEOUT`.",
        "- **no_answer_extracted**: agent never emits `ANSWER: ...` line.",
        "- **missing_file**: question references a file not present on disk.",
        "",
    ]
    md_path.write_text("\n".join(lines))
    return md_path


def _cell(s: str) -> str:
    return (s[:40] + "…") if len(s) > 40 else s


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=5,
                    help="Max questions to run (default 5)")
    ap.add_argument("--offset", type=int, default=0,
                    help="Start index into the L1 question list")
    ap.add_argument("--no-file", action="store_true",
                    help="Only run questions without file attachments")
    ap.add_argument("--file-only", action="store_true",
                    help="Only run questions with file attachments")
    ap.add_argument("--task-ids", type=str, default="",
                    help="Comma-separated task_id prefixes to run (matches startswith)")
    args = ap.parse_args()

    ensure_agent()
    df = load_l1()
    if args.no_file:
        df = df[df["file_name"].isna() | (df["file_name"] == "")]
    if args.file_only:
        df = df[df["file_name"].notna() & (df["file_name"] != "")]
    if args.task_ids:
        prefixes = [p.strip() for p in args.task_ids.split(",") if p.strip()]
        df = df[df["task_id"].apply(lambda t: any(t.startswith(p) for p in prefixes))]
        df = df.reset_index(drop=True)
    df = df.iloc[args.offset:args.offset + args.limit]
    print(f"Running {len(df)} questions (offset={args.offset})")

    run_id = time.strftime("run_%Y%m%d_%H%M%S")
    results: list[QResult] = []
    for i, (_, row) in enumerate(df.iterrows(), 1):
        print(f"\n[{i}/{len(df)}] {row['task_id'][:8]}  "
              f"Q: {row['Question'][:80].strip()!r}…")
        qr = run_one(row)
        tag = "✅" if qr.passed else "❌"
        print(f"    {tag} status={qr.status}  pred={qr.prediction!r}  "
              f"truth={qr.ground_truth!r}  tools={qr.n_tool_calls}  "
              f"elapsed={qr.elapsed_s:.0f}s  defects={qr.defect_tags}")
        results.append(qr)

    md = write_report(run_id, results)
    print(f"\n=== Report: {md} ===")


if __name__ == "__main__":
    main()
